<?xml version="1.0" encoding="UTF-8"?>
<idea-plugin>
    <id>ru.pvlapvp.ci-actions-monitor</id>
    <name>CI Actions Monitor</name>
    <version>1.1.0</version>
    <vendor>pvlapvp</vendor>

    <description><![CDATA[
        Browse Gitea and GitHub Actions in the standard Services tool window:
        connections, repositories, workflows, runs, jobs and job logs.
        Test connections and store tokens in IntelliJ PasswordSafe.
    ]]></description>

    <idea-version since-build="263"/>

    <depends>com.intellij.modules.platform</depends>

    <extensionPoint name="actionsProvider"
                    interface="ru.pvlapvp.ciactionsmonitor.provider.ActionsProviderFactory"/>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="ru.pvlapvp.ciactionsmonitor.settings.ActionsSettings"/>

        <applicationConfigurable
                id="ru.pvlapvp.ciactionsmonitor.settings"
                displayName="CI Actions Monitor"
                parentId="tools"
                instance="ru.pvlapvp.ciactionsmonitor.settings.ActionsSettingsConfigurable"/>

        <!--
            Integrates into the standard Services tool window. Do not register a
            separate com.intellij.toolWindow for this plugin.
        -->
        <serviceViewContributor
                implementation="ru.pvlapvp.ciactionsmonitor.ui.ActionsServiceViewContributor"/>
    </extensions>

    <extensions defaultExtensionNs="ru.pvlapvp.ci-actions-monitor">
        <actionsProvider implementation="ru.pvlapvp.ciactionsmonitor.provider.gitea.GiteaProviderFactory"/>
        <actionsProvider implementation="ru.pvlapvp.ciactionsmonitor.provider.github.GitHubProviderFactory"/>
    </extensions>

    <actions>
        <action id="CiActions.OpenSettings"
                class="ru.pvlapvp.ciactionsmonitor.settings.OpenSettingsAction"
                text="CI Actions Monitor Settings..."
                description="Configure CI/CD connections, repositories and access tokens">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
